# TigerSwap environment template.
#
# Copy to .env and fill in real values. Never commit .env. The API has no
# database defaults by design, so DB_* and JWT_SECRET must be set or it will
# refuse to start.

# --- Database (required) -----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=tigerswap
DB_PASSWORD=change-me
DB_NAME=tigerswap
# Postgres TLS mode. Defaults to "require"; set "disable" only when the database
# is reached over a private network without TLS (as in docker-compose).
DB_SSLMODE=require

# --- Auth and signing (required for the features named) ----------------------
# Signs and verifies session JWTs. Required for any authenticated route.
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts custodial wallet keys at rest; enables the custody endpoints.
WALLET_ENCRYPTION_KEY=
# BIP-39 seed that derives deposit addresses.
WALLET_HD_SEED=
# Signs platform withdrawals.
PLATFORM_SIGNER_KEY=
# Optional signer used by the swap/bridge execution paths.
TIGERSWAP_SIGNER_KEY=

# --- First-boot operator account (optional) ----------------------------------
# Created on first startup if set; otherwise create an admin out of band.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- HTTP ---------------------------------------------------------------------
PORT=8080
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Peers allowed to set the client IP via a forwarding header.
TRUSTED_PROXIES=

# --- Chains --------------------------------------------------------------------
# Comma-separated chain ids the deposit watcher scans.
DEPOSIT_WATCH_CHAINS=
# Settlement chain for perps/margin/OTC escrow (token registry for RUSD, etc.).
TIGERSWAP_DEFAULT_CHAIN=
# Per-chain RPC endpoints. TigerSwap dials only its own nodes. TIGERSWAP_RPC_<id>
# (or TIGERSWAP_RPC_URL_<id>) takes precedence over the rpc_url stored on the
# blockchains row. Example for chain 1:
# TIGERSWAP_RPC_1=https://your-ethereum-node.example
# TIGERSWAP_FACTORY_1=0xYourFactoryAddress

# --- Bridge --------------------------------------------------------------------
# TIGERBRIDGE_ROUTER=0xRouter
# TIGERBRIDGE_RELAYER_KEY=
# Comma-separated validator keys that co-sign bridge completions.
# TIGERBRIDGE_VALIDATOR_KEYS=

# --- NFT fees ------------------------------------------------------------------
# NFT_FEE_ACCOUNT=0xFeeRecipient
# NFT_FEE_BPS=250

# --- Frontend build-time (baked into the client bundle) ------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional; derived from the API base when unset.
NEXT_PUBLIC_WS_URL=
