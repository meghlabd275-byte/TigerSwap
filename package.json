{
  "name": "tigerswap-monorepo",
  "version": "1.0.0",
  "description": "TigerSwap - Enterprise-grade multichain decentralized exchange ecosystem",
  "private": true,
  "workspaces": [
    "frontend/*",
    "blockchain_layer/evm_sdk"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/validate-repo.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  }
}
