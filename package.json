{
  "name": "tigerswap-monorepo",
  "version": "1.0.0",
  "description": "TigerSwap - Enterprise-grade multichain decentralized exchange ecosystem",
  "private": true,
  "workspaces": [
    "admin_platform/*",
    "ai_platform/*",
    "analytics_platform/*",
    "api_gateway/*",
    "blockchain_layer/*",
    "cex_connectors/*",
    "core",
    "cross_chain_protocol/*",
    "dapp_browser/*",
    "dex_aggregator/*",
    "dex_connectors/*",
    "frontend/*",
    "governance/*",
    "libs/*",
    "market_maker_platform/*",
    "mm_bot_platform/*",
    "mobile/*",
    "security_platform/*",
    "smart_contracts/*",
    "subgraph",
    "user_features/*",
    "wallet_ecosystem/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/validate-repo.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  }
}
